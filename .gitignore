# --------------------------
# PYTHON / ML ADDITIONS
# --------------------------

# Python Cache
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Virtual Environments
venv/
env/
ml_env/
.env

# Large Model Weights (Training checkpoints)
# We exclude these to save space, but keep the deployed .ptl file in the app assets
*.pth
*.pt
*.h5
*.ckpt
*.onnx
ml/**/*.ptl

# Allow packaged models in the Android app assets
!app/src/main/assets/*.ptl

# Datasets (Images and Annotations)
ml/**/dataset*/
ml/**/*dataset*/
ml/**/*.folder*/
ml/**/data/
ml/**/images/
ml/**/Tomato Dataset/
ml/**/*.json
ml/**/*.png

# Training Outputs and Checkpoints
ml/**/training_output*/
ml/**/runs/
ml/**/export/
ml/**/checkpoints/
ml/**/Robust_Models/

# IDE specific for Python
.vscode/

# --------------------------
# CLOUD FUNCTIONS
# --------------------------
functions/node_modules/
functions/firebase-debug.log
functions/firebase-debug.*.log
functions/.env
functions/.env.*
functions/coverage/

# --------------------------
# LOCAL SCRATCH / DOCS / MOCKUPS (not needed to build the app)
# --------------------------
.claude/
_scratch/
_fmt_styles.txt

# Consolidated Documentation folder
documentation/

# Extra Environment ignores
*.env
*.env.*
!.env.example
