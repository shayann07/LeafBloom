<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/loading_leaf">

    <!-- Rocking/breathing after intro -->
    <target
        android:name="rootGroup"
        android:animation="@animator/leaf_rock" />

    <!-- Intro: segments slide+fade in one by one -->
    <target
        android:name="seg0"
        android:animation="@animator/leaf_seg_intro_0" />
    <target
        android:name="seg1"
        android:animation="@animator/leaf_seg_intro_1" />
    <target
        android:name="seg2"
        android:animation="@animator/leaf_seg_intro_2" />
    <target
        android:name="seg3"
        android:animation="@animator/leaf_seg_intro_3" />
    <target
        android:name="seg4"
        android:animation="@animator/leaf_seg_intro_4" />
    <target
        android:name="seg5"
        android:animation="@animator/leaf_seg_intro_5" />
    <target
        android:name="seg6"
        android:animation="@animator/leaf_seg_intro_6" />
    <target
        android:name="seg7"
        android:animation="@animator/leaf_seg_intro_7" />

    <!-- Glow pulses during hold (on inner groups) -->
    <target
        android:name="seg0_inner"
        android:animation="@animator/leaf_seg_pulse_0" />
    <target
        android:name="seg1_inner"
        android:animation="@animator/leaf_seg_pulse_1" />
    <target
        android:name="seg2_inner"
        android:animation="@animator/leaf_seg_pulse_2" />
    <target
        android:name="seg3_inner"
        android:animation="@animator/leaf_seg_pulse_3" />
    <target
        android:name="seg4_inner"
        android:animation="@animator/leaf_seg_pulse_4" />
    <target
        android:name="seg5_inner"
        android:animation="@animator/leaf_seg_pulse_5" />
    <target
        android:name="seg6_inner"
        android:animation="@animator/leaf_seg_pulse_6" />
    <target
        android:name="seg7_inner"
        android:animation="@animator/leaf_seg_pulse_7" />

</animated-vector>
