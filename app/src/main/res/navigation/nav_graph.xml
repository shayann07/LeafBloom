<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/walkthroughFragment"
        android:name="com.devsphere.leafbloom.ui.walkthrough.WalkthroughFragment"
        android:label="Walkthrough"
        tools:layout="@layout/fragment_walkthrough" />

    <fragment
        android:id="@+id/modelDownloadFragment"
        android:name="com.devsphere.leafbloom.ui.modelDownload.ModelDownloadFragment"
        android:label="Model Download"
        tools:layout="@layout/fragment_model_download">
        <action
            android:id="@+id/action_modelDownload_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.devsphere.leafbloom.ui.home.HomeFragment"
        android:label="Home Fragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_scannerFragment"
            app:destination="@id/scannerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_historyDetailsFragment"
            app:destination="@id/historyDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_pestResultFragment"
            app:destination="@id/pestResultFragment" />
        <action
            android:id="@+id/action_homeFragment_to_identifyResultFragment"
            app:destination="@id/identifyResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/scannerFragment"
        android:name="com.devsphere.leafbloom.ui.scanner.ScannerFragment"
        android:label="Scanner Fragment"
        tools:layout="@layout/fragment_scanner">
        <action
            android:id="@+id/action_scannerFragment_to_diagnoseResultFragment"
            app:destination="@id/diagnoseResultFragment"
            app:popUpTo="@id/scannerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_scannerFragment_to_identifyResultFragment"
            app:destination="@id/identifyResultFragment"
            app:popUpTo="@id/scannerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_scannerFragment_to_pestResultFragment"
            app:destination="@id/pestResultFragment"
            app:popUpTo="@id/scannerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_scannerFragment_to_ripenessResultFragment"
            app:destination="@id/ripenessResultFragment" />
        <action
            android:id="@+id/action_scannerFragment_to_cropFragment"
            app:destination="@id/cropFragment" />
    </fragment>

    <fragment
        android:id="@+id/cropFragment"
        android:name="com.devsphere.leafbloom.ui.scanner.CropFragment"
        android:label="Crop Fragment"
        tools:layout="@layout/fragment_crop" />

    <fragment
        android:id="@+id/diagnoseResultFragment"
        android:name="com.devsphere.leafbloom.ui.result.DiagnoseResultFragment"
        android:label="@string/diagnose_result"
        tools:layout="@layout/fragment_diagnose_result" />

    <fragment
        android:id="@+id/identifyResultFragment"
        android:name="com.devsphere.leafbloom.ui.result.IdentifyResultFragment"
        android:label="Identify Result"
        tools:layout="@layout/fragment_identify_result" />

    <fragment
        android:id="@+id/pestResultFragment"
        android:name="com.devsphere.leafbloom.ui.result.PestResultFragment"
        android:label="Pest Result"
        tools:layout="@layout/fragment_pest_result" />

    <fragment
        android:id="@+id/ripenessResultFragment"
        android:name="com.devsphere.leafbloom.ui.result.RipenessResultFragment"
        android:label="Ripeness Result"
        tools:layout="@layout/fragment_ripeness_result" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.devsphere.leafbloom.ui.history.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_historyFragment_to_historyDetailsFragment"
            app:destination="@id/historyDetailsFragment" />
        <action
            android:id="@+id/action_historyFragment_to_pestResultFragment"
            app:destination="@id/pestResultFragment" />
        <action
            android:id="@+id/action_historyFragment_to_identifyResultFragment"
            app:destination="@id/identifyResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyDetailsFragment"
        android:name="com.devsphere.leafbloom.ui.history.HistoryDetailsFragment"
        android:label="History Details"
        tools:layout="@layout/fragment_history_details" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.devsphere.leafbloom.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

</navigation>