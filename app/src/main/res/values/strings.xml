    <!-- Disease tips -->
    <string name="disease_tip1_title_early_blight">Remove Infected Leaves</string>
    <string name="disease_tip1_desc_early_blight">Prune and destroy lower leaves showing target-like brown spots with concentric rings. Do not compost infected debris.</string>
    <string name="disease_tip2_title_early_blight">Apply Fungicide</string>
    <string name="disease_tip2_desc_early_blight">Spray Mancozeb or Saaf (Carbendazim + Mancozeb), widely available in Pakistan. Apply every 7–10 days during humid weather. Rotate with copper-based fungicides.</string>

    <string name="disease_tip1_title_healthy">Maintain Good Practices</string>
    <string name="disease_tip1_desc_healthy">Continue watering at the base, not on foliage. Ensure proper spacing between plants for air circulation.</string>
    <string name="disease_tip2_title_healthy">Preventive Care</string>
    <string name="disease_tip2_desc_healthy">Apply a preventive copper spray during monsoon season. Rotate crops every 2–3 years and keep the garden free of weeds.</string>

    <string name="disease_tip1_title_late_blight">Immediate Removal</string>
    <string name="disease_tip1_desc_late_blight">Remove and destroy all infected leaves, stems, and fruits immediately. Late blight spreads rapidly in cool, wet conditions (18–22°C).</string>
    <string name="disease_tip2_title_late_blight">Apply Systemic Fungicide</string>
    <string name="disease_tip2_desc_late_blight">Spray Ridomil Gold (Metalaxyl + Mancozeb) or Curzate M. These are widely available from agricultural dealers in Pakistan. Start treatment at first symptoms.</string>

    <string name="disease_tip1_title_septoria">Remove Lower Leaves</string>
    <string name="disease_tip1_desc_septoria">Strip infected lower leaves showing small spots with gray centers and dark borders. Look for tiny black dots (pycnidia) in spot centers.</string>
    <string name="disease_tip2_title_septoria">Prevent Soil Splash</string>
    <string name="disease_tip2_desc_septoria">Mulch around plant base with wheat straw to prevent rain splashing spores onto leaves. Apply Chlorothalonil or Mancozeb every 7 days during wet spells.</string>

    <string name="disease_tip1_title_unknown">Retake Photo</string>
    <string name="disease_tip1_desc_unknown">Ensure the leaf is well-lit, in focus, and fills most of the frame for accurate diagnosis.</string>
    <string name="disease_tip2_title_unknown">General Care</string>
    <string name="disease_tip2_desc_unknown">Water at the base, maintain proper spacing, and monitor leaves daily for any changes in color or texture.</string>

