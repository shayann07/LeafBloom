<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/LeafBloomCard.Large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/safe_margin_v"
    app:cardElevation="@dimen/space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/space_64"
            android:layout_height="@dimen/space_64"
            android:layout_marginBottom="@dimen/space_16"
            android:src="@drawable/app_logo"
            app:tint="@color/brand_green_primary" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/permissions_required"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24"
            android:gravity="center"
            android:text="@string/permissions_required_dialog_desc"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/LeafBloomButtonSurfaceVariant.Compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_weight="1"
                android:text="@string/not_now" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAllow"
                style="@style/LeafBloomButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:text="@string/continue_text" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>