<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_40"
    android:paddingEnd="0dp"
    android:paddingVertical="@dimen/space_6">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bubbleCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/brand_green_primary"
        app:cardElevation="@dimen/space_2"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LeafBloom.ChatBubbleUser"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_12"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/white" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
