<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:fitsSystemWindows="false">

        <!-- Horizontal Guidelines -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="@dimen/safe_margin_v" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_end="@dimen/safe_margin_v" />

        <!-- Vertical Guidelines -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/safe_margin_h" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/safe_margin_h" />

        <!-- Header with background image -->
        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_header_height"
            android:background="@drawable/auth_header_mask"
            android:clipToOutline="true"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/home_header" />

            <!-- Header overlay content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/safe_margin_h"
                android:layout_marginTop="@dimen/safe_margin_v"
                android:layout_marginEnd="@dimen/safe_margin_h"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/safe_margin_v">

                <!-- Your location label -->
                <TextView
                    android:id="@+id/tvYourLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:text="@string/your_location"
                    android:textColor="@color/text_on_dark"
                    android:textSize="12sp" />

                <!-- Location row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivLocation"
                        android:layout_width="@dimen/size_icon_18"
                        android:layout_height="@dimen/size_icon_18"
                        android:contentDescription="@null"
                        android:src="@drawable/location_icon" />

                    <TextView
                        android:id="@+id/tvLocationValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:alpha="0.95"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Sargodha, Punjab, Pakistan" />
                </LinearLayout>

                <!-- Search bar -->
                <LinearLayout
                    android:id="@+id/searchContainer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_search"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/search_bar_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_14"
                    android:paddingEnd="@dimen/space_14">

                    <ImageView
                        android:id="@+id/ivSearch"
                        android:layout_width="@dimen/size_icon_18"
                        android:layout_height="@dimen/size_icon_18"
                        android:contentDescription="@null"
                        android:src="@drawable/search_icon"
                        app:tint="@color/text_hint" />

                    <TextView
                        android:id="@+id/tvSearchHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:text="@string/search_plants_hint"
                        android:textColor="@color/text_hint"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Main content (overlaps header using guidelines) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/guideline_top">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:orientation="vertical"
                android:paddingTop="76dp"
                android:paddingBottom="@dimen/safe_margin_v">

                <!-- Weather card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWeather"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_100"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="@dimen/radius_24"
                    app:cardElevation="@dimen/space_0"
                    app:strokeColor="@color/outline_soft"
                    app:strokeWidth="@dimen/card_stroke">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:id="@+id/tvTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/brand_green_primary_dark"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="23°C" />

                        <TextView
                            android:id="@+id/tvWeatherLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textColor="@color/brand_green_text"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvTemp"
                            tools:text="Sargodha ,Pakistan" />

                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="@dimen/space_72"
                            android:layout_height="@dimen/space_56"
                            android:contentDescription="@null"
                            android:src="@drawable/cloud_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Plant category chips -->
                <HorizontalScrollView
                    android:id="@+id/chipsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chipsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Icon chip 1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/height_chip"
                            android:layout_height="@dimen/height_chip"
                            app:cardBackgroundColor="@color/surface_card"
                            app:cardCornerRadius="@dimen/radius_pill"
                            app:cardElevation="@dimen/space_0"
                            app:strokeColor="@color/outline_soft"
                            app:strokeWidth="@dimen/card_stroke">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="@dimen/space_8"
                                android:src="@drawable/tree_icon"
                                app:tint="@color/brand_green_text" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Icon chip 2 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/height_chip"
                            android:layout_height="@dimen/height_chip"
                            android:layout_marginStart="@dimen/space_10"
                            app:cardBackgroundColor="@color/surface_card"
                            app:cardCornerRadius="@dimen/radius_pill"
                            app:cardElevation="@dimen/space_0"
                            app:strokeColor="@color/outline_soft"
                            app:strokeWidth="@dimen/card_stroke">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="@dimen/space_8"
                                android:src="@drawable/tree_icon"
                                app:tint="@color/brand_green_text" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Selected chip (Tomato) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipSelected"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/height_chip"
                            android:layout_marginStart="@dimen/space_10"
                            app:cardBackgroundColor="@color/brand_green_primary"
                            app:cardCornerRadius="@dimen/radius_pill"
                            app:cardElevation="@dimen/space_0">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/space_6"
                                android:paddingEnd="@dimen/space_16">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="@dimen/space_24"
                                    android:layout_height="@dimen/space_24"
                                    app:cardBackgroundColor="@color/surface_card"
                                    app:cardCornerRadius="@dimen/radius_pill"
                                    app:cardElevation="@dimen/space_0">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="@null"
                                        android:padding="@dimen/space_4"
                                        android:src="@drawable/home_bar2" />
                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_8"
                                    android:text="Tomato"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Icon chip 3 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/height_chip"
                            android:layout_height="@dimen/height_chip"
                            android:layout_marginStart="@dimen/space_10"
                            app:cardBackgroundColor="@color/surface_card"
                            app:cardCornerRadius="@dimen/radius_pill"
                            app:cardElevation="@dimen/space_0"
                            app:strokeColor="@color/outline_soft"
                            app:strokeWidth="@dimen/card_stroke">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="@dimen/space_8"
                                android:src="@drawable/tree_icon"
                                app:tint="@color/brand_green_text" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Icon chip 4 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/height_chip"
                            android:layout_height="@dimen/height_chip"
                            android:layout_marginStart="@dimen/space_10"
                            app:cardBackgroundColor="@color/surface_card"
                            app:cardCornerRadius="@dimen/radius_pill"
                            app:cardElevation="@dimen/space_0"
                            app:strokeColor="@color/outline_soft"
                            app:strokeWidth="@dimen/card_stroke">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="@dimen/space_8"
                                android:src="@drawable/tree_icon"
                                app:tint="@color/brand_green_text" />
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Check your plant card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCheckPlant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="@dimen/radius_24"
                    app:cardElevation="@dimen/space_0"
                    app:strokeColor="@color/outline_soft"
                    app:strokeWidth="@dimen/card_stroke">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/card_padding">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/checkImageHolder"
                            android:layout_width="@dimen/space_100"
                            android:layout_height="@dimen/space_100"
                            app:cardBackgroundColor="@color/surface_variant"
                            app:cardCornerRadius="@dimen/radius_16"
                            app:cardElevation="@dimen/space_0"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:scaleType="centerInside"
                                android:src="@drawable/home_diagnose" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvCheckTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:text="@string/check_your_plant"
                            android:textColor="@color/brand_green_primary_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/checkImageHolder"
                            app:layout_constraintTop_toTopOf="@id/checkImageHolder" />

                        <TextView
                            android:id="@+id/tvCheckDesc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/check_your_plant_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/checkImageHolder"
                            app:layout_constraintTop_toBottomOf="@id/tvCheckTitle" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDiagnose"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/space_36"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_marginTop="@dimen/space_10"
                            android:text="@string/diagnose"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            app:cornerRadius="@dimen/radius_pill"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/checkImageHolder"
                            app:layout_constraintTop_toBottomOf="@id/tvCheckDesc" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- All Features section title -->
                <TextView
                    android:id="@+id/tvAllFeatures"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="@string/all_features"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Features 2x2 grid -->
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/featuresGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:columnCount="2"
                    app:rowCount="2">

                    <!-- Feature 1: Diagnose -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_6"
                        android:layout_marginBottom="@dimen/space_12"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="@dimen/radius_20"
                        app:cardElevation="@dimen/space_0"
                        app:layout_columnWeight="1"
                        app:strokeColor="@color/outline_soft"
                        app:strokeWidth="@dimen/card_stroke">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/feature_diagnose"
                                android:textColor="@color/brand_green_primary_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/feature_diagnose_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/space_72"
                                android:layout_marginTop="@dimen/space_10"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/home_feature1" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Feature 2: Identify -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:layout_marginBottom="@dimen/space_12"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="@dimen/radius_20"
                        app:cardElevation="@dimen/space_0"
                        app:layout_columnWeight="1"
                        app:strokeColor="@color/outline_soft"
                        app:strokeWidth="@dimen/card_stroke">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/feature_identify"
                                android:textColor="@color/brand_green_primary_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/feature_identify_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/space_72"
                                android:layout_marginTop="@dimen/space_10"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/home_feature2" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Feature 3: IoT Watering -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_6"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="@dimen/radius_20"
                        app:cardElevation="@dimen/space_0"
                        app:layout_columnWeight="1"
                        app:strokeColor="@color/outline_soft"
                        app:strokeWidth="@dimen/card_stroke">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/feature_iot_watering"
                                android:textColor="@color/brand_green_primary_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/feature_iot_watering_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/space_72"
                                android:layout_marginTop="@dimen/space_10"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/home_feature3" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Feature 4: Reminders -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="@dimen/radius_20"
                        app:cardElevation="@dimen/space_0"
                        app:layout_columnWeight="1"
                        app:strokeColor="@color/outline_soft"
                        app:strokeWidth="@dimen/card_stroke">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/feature_reminders"
                                android:textColor="@color/brand_green_primary_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/feature_reminders_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/space_72"
                                android:layout_marginTop="@dimen/space_10"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/home_feature4" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </androidx.gridlayout.widget.GridLayout>

                <!-- History section title -->
                <TextView
                    android:id="@+id/tvHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="@string/history"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- History card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="@dimen/radius_24"
                    app:cardElevation="@dimen/space_0"
                    app:strokeColor="@color/outline_soft"
                    app:strokeWidth="@dimen/card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_8">

                        <!-- History item 1 -->
                        <include
                            android:id="@+id/historyItem1"
                            layout="@layout/item_history" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_marginEnd="@dimen/space_8"
                            android:alpha="0.6"
                            android:background="@color/outline_soft" />

                        <!-- History item 2 -->
                        <include
                            android:id="@+id/historyItem2"
                            layout="@layout/item_history" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_marginEnd="@dimen/space_8"
                            android:alpha="0.6"
                            android:background="@color/outline_soft" />

                        <!-- History item 3 -->
                        <include
                            android:id="@+id/historyItem3"
                            layout="@layout/item_history" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tips & Tricks section title -->
                <TextView
                    android:id="@+id/tvTips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="@string/tips_and_tricks"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Tips horizontal scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Tip card 1: Healthy Start -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/space_160"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/surface_card"
                            app:cardCornerRadius="@dimen/radius_20"
                            app:cardElevation="@dimen/space_0"
                            app:strokeColor="@color/outline_soft"
                            app:strokeWidth="@dimen/card_stroke">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/card_padding">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🌱"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/space_6"
                                        android:text="@string/tip_healthy_start"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:text="@string/tip_healthy_start_desc"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Tip card 2: Keep Air Flowing -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/space_160"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            app:cardBackgroundColor="@color/surface_card"
                            app:cardCornerRadius="@dimen/radius_20"
                            app:cardElevation="@dimen/space_0"
                            app:strokeColor="@color/outline_soft"
                            app:strokeWidth="@dimen/card_stroke">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/card_padding">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🌞"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/space_6"
                                        android:text="@string/tip_keep_air_flowing"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:text="@string/tip_keep_air_flowing_desc"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>