<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:fitsSystemWindows="false">

        <!-- Horizontal Guidelines -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="@dimen/safe_margin_v" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_end="@dimen/safe_margin_v" />

        <!-- Vertical Guidelines -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/safe_margin_h" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/safe_margin_h" />

        <!-- Header with background image -->
        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_header_height"
            android:background="@drawable/auth_header_mask"
            android:clipToOutline="true"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/home_header" />

            <!-- Header overlay content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/safe_margin_h"
                android:layout_marginTop="@dimen/safe_margin_v"
                android:layout_marginEnd="@dimen/safe_margin_h"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/safe_margin_v">

                <!-- Your location label -->
                <TextView
                    android:id="@+id/tvYourLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:text="@string/your_location"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/text_on_dark" />

                <!-- Location row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivLocation"
                        android:layout_width="@dimen/size_icon_18"
                        android:layout_height="@dimen/size_icon_18"
                        android:contentDescription="@null"
                        android:src="@drawable/location_icon" />

                    <TextView
                        android:id="@+id/tvLocationValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/text_on_dark"
                        tools:text="Sargodha, Punjab, Pakistan" />
                </LinearLayout>

                <!-- Search bar -->
                <LinearLayout
                    android:id="@+id/searchContainer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_search"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/search_bar_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_14"
                    android:paddingEnd="@dimen/space_14">

                    <ImageView
                        android:id="@+id/ivSearch"
                        android:layout_width="@dimen/size_icon_18"
                        android:layout_height="@dimen/size_icon_18"
                        android:contentDescription="@null"
                        android:src="@drawable/search_icon"
                        app:tint="@color/text_hint" />

                    <TextView
                        android:id="@+id/tvSearchHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:text="@string/search_plants_hint"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Main content (overlaps header using guidelines) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/guideline_top">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:orientation="vertical"
                android:paddingTop="76dp"
                android:paddingBottom="@dimen/safe_margin_v">

                <!-- Start Coding Here -->

                <!-- Weather card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWeather"
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="@dimen/space_100"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:id="@+id/tvTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.LeafBloom.Temperature"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="23°C" />

                        <TextView
                            android:id="@+id/tvWeatherLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textAppearance="@style/TextAppearance.LeafBloom.WeatherLocation"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvTemp"
                            tools:text="Sargodha, Pakistan" />

                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="@dimen/space_72"
                            android:layout_height="@dimen/space_56"
                            android:contentDescription="@null"
                            android:src="@drawable/cloud_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Plant category chips (Material Chips with collapse/expand) -->
                <HorizontalScrollView
                    android:id="@+id/chipsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPlant1"
                            style="@style/LeafChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rose"
                            app:chipIcon="@drawable/home_bar1" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPlant2"
                            style="@style/LeafChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lily"
                            app:chipIcon="@drawable/home_bar2" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTomato"
                            style="@style/LeafChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Tomato"
                            app:chipIcon="@drawable/home_bar3" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPlant3"
                            style="@style/LeafChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mint"
                            app:chipIcon="@drawable/home_bar4" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPlant4"
                            style="@style/LeafChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Basil"
                            app:chipIcon="@drawable/home_bar5" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Check your plant card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCheckPlant"
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_12">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/checkImageHolder"
                            style="@style/LeafBloomCard.NoStroke"
                            android:layout_width="115dp"
                            android:layout_height="@dimen/check_plant_image_size"
                            app:cardBackgroundColor="@color/surface_variant"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:paddingTop="@dimen/space_12"
                                android:scaleType="centerInside"
                                android:src="@drawable/home_diagnose" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvCheckTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_14"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/check_your_plant"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/checkImageHolder"
                            app:layout_constraintTop_toTopOf="@id/checkImageHolder" />

                        <TextView
                            android:id="@+id/tvCheckDesc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_14"
                            android:layout_marginTop="@dimen/space_6"
                            android:text="@string/check_your_plant_desc"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/checkImageHolder"
                            app:layout_constraintTop_toBottomOf="@id/tvCheckTitle" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDiagnose"
                            style="@style/LeafBloomButton.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/space_36"
                            android:layout_marginStart="@dimen/space_14"
                            android:layout_marginTop="@dimen/space_14"
                            android:text="@string/diagnose"
                            app:layout_constraintStart_toEndOf="@id/checkImageHolder"
                            app:layout_constraintTop_toBottomOf="@id/tvCheckDesc" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- All Features section title -->
                <TextView
                    android:id="@+id/tvAllFeatures"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/all_features"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Features Row 1 (equal height cards) -->
                <LinearLayout
                    android:id="@+id/featuresRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Feature 1: Diagnose -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/LeafBloomCard.Medium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/space_6"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="@dimen/feature_card_min_height">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/card_padding"
                                android:layout_marginTop="@dimen/card_padding"
                                android:text="@string/feature_diagnose"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/card_padding"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/feature_diagnose_desc"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/feature_card_image_height"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/home_feature1" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Feature 2: Identify -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/LeafBloomCard.Medium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_6"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="@dimen/feature_card_min_height">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/card_padding"
                                android:layout_marginTop="@dimen/card_padding"
                                android:text="@string/feature_identify"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/card_padding"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/feature_identify_desc"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/feature_card_image_height"
                                android:layout_marginTop="@dimen/space_8"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/home_feature2" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Features Row 2 (equal height cards) -->
                <LinearLayout
                    android:id="@+id/featuresRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Feature 3: IoT Watering -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/LeafBloomCard.Medium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/space_6"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="@dimen/feature_card_min_height">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/card_padding"

                                android:layout_marginTop="@dimen/card_padding"
                                android:text="@string/feature_iot_watering"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/card_padding"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/feature_iot_watering_desc"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/feature_card_image_height"
                                android:layout_marginTop="@dimen/space_8"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/home_feature3" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Feature 4: Reminders -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/LeafBloomCard.Medium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_6"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="@dimen/feature_card_min_height">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/card_padding"
                                android:layout_marginTop="@dimen/card_padding"
                                android:text="@string/feature_reminders"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/card_padding"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/feature_reminders_desc"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/feature_card_image_height"
                                android:layout_marginTop="@dimen/space_8"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/home_feature4" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- History section title -->
                <TextView
                    android:id="@+id/tvHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/history"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <!-- History card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHistory"
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_history" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Tips & Tricks section title -->
                <TextView
                    android:id="@+id/tvTips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/tips_and_tricks"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Tips horizontal scroll (equal height cards) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Tip card 1: Healthy Start -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/LeafBloomCard.Medium"
                            android:layout_width="@dimen/tip_card_width"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="@dimen/tip_card_min_height">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="@dimen/card_padding">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="@dimen/size_icon_18"
                                        android:layout_height="@dimen/size_icon_18"
                                        android:contentDescription="@null"
                                        android:src="@drawable/home_bar4" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/space_6"
                                        android:text="@string/tip_healthy_start"
                                        android:textAppearance="?attr/textAppearanceTitleSmall"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:text="@string/tip_healthy_start_desc"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Tip card 2: Keep Air Flowing -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/LeafBloomCard.Medium"
                            android:layout_width="@dimen/tip_card_width"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="@dimen/tip_card_min_height">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="@dimen/card_padding">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="@dimen/size_icon_18"
                                        android:layout_height="@dimen/size_icon_18"
                                        android:contentDescription="@null"
                                        android:src="@drawable/sun_icon" />

                                    <TextView
