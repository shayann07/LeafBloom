<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="@dimen/safe_margin_v" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/safe_margin_h" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/safe_margin_h" />

        <!-- Header: centered title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center"
            android:text="@string/disease_library_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toTopOf="@id/guideline_top" />

        <!-- Search bar -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_search"
            android:layout_marginTop="@dimen/space_20"
            android:background="@drawable/search_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_14"
            android:paddingEnd="@dimen/space_14"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="@dimen/size_icon_18"
                android:layout_height="@dimen/size_icon_18"
                android:contentDescription="@null"
                android:src="@drawable/search_icon"
                app:tint="@color/text_hint" />

            <EditText
                android:id="@+id/etSearch"
                style="@style/LeafSearchEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:hint="@string/search_diseases_hint"
                android:importantForAutofill="no" />

            <ImageView
                android:id="@+id/ivClearSearch"
                android:layout_width="@dimen/size_icon_18"
                android:layout_height="@dimen/size_icon_18"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_close_search"
                android:visibility="gone"
                app:tint="@color/text_hint" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNoResults"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/searchContainer"
            tools:text="No results for &quot;blight&quot;" />

        <!-- Daily Plant Tip header -->
        <LinearLayout
            android:id="@+id/tipHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/searchContainer">

            <ImageView
                android:layout_width="@dimen/size_icon_20"
                android:layout_height="@dimen/size_icon_20"
                android:contentDescription="@null"
                android:src="@drawable/ic_bulb_24"
                app:tint="@color/accent_sun_yellow" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:text="@string/daily_plant_tip"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvTipPager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/text_secondary"
                tools:text="1/3" />
        </LinearLayout>

        <!-- Tip carousel -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/tipPager"
            android:layout_width="0dp"
            android:layout_height="@dimen/tip_pager_height"
            android:layout_marginTop="@dimen/space_12"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tipHeader"
            tools:background="@color/brand_green_container" />

        <!-- Dot indicators -->
        <LinearLayout
            android:id="@+id/dotIndicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tipPager">

            <View
                android:layout_width="18dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="@dimen/space_4"
                android:background="@drawable/dot_active"
                tools:ignore="UseAppTint" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="@dimen/space_4"
                android:background="@drawable/dot_inactive" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="@dimen/space_4"
                android:background="@drawable/dot_inactive" />
        </LinearLayout>

        <!-- Categories section title -->
        <TextView
            android:id="@+id/tvCategoriesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/categories"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/dotIndicators" />

        <!-- Categories 2x2 grid -->
        <LinearLayout
            android:id="@+id/categoriesGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tvCategoriesTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/slotCatFungal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_6"
                    android:layout_weight="1"
                    tools:layout="@layout/item_category_tile" />

                <FrameLayout
                    android:id="@+id/slotCatBacterial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:layout_weight="1"
                    tools:layout="@layout/item_category_tile" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/slotCatViral"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_6"
                    android:layout_weight="1"
                    tools:layout="@layout/item_category_tile" />

                <FrameLayout
                    android:id="@+id/slotCatPest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:layout_weight="1"
                    tools:layout="@layout/item_category_tile" />
            </LinearLayout>
        </LinearLayout>

        <!-- Detected by App title -->
        <TextView
            android:id="@+id/tvDetectedTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/detected_by_app"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/categoriesGrid" />

        <!-- Detected 2x2 grid -->
        <LinearLayout
            android:id="@+id/detectedGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tvDetectedTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_6"
                    android:layout_weight="1"
                    layout="@layout/item_disease_tile" />

                <include
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:layout_weight="1"
                    layout="@layout/item_disease_tile" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_6"
                    android:layout_weight="1"
                    layout="@layout/item_disease_tile" />

                <include
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:layout_weight="1"
                    layout="@layout/item_disease_tile" />
            </LinearLayout>
        </LinearLayout>

        <!-- Other Tomato Diseases header -->
        <LinearLayout
            android:id="@+id/otherHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/detectedGrid">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/other_tomato_diseases"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/space_4"
                android:text="@string/see_all"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/brand_green_primary" />
        </LinearLayout>

        <!-- Other diseases grid -->
        <LinearLayout
            android:id="@+id/otherGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_24"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/otherHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_6"
                    android:layout_weight="1"
                    layout="@layout/item_disease_tile" />

                <include
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:layout_weight="1"
                    layout="@layout/item_disease_tile" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/safe_margin_h"
        android:layout_marginBottom="@dimen/space_24"
        android:contentDescription="@string/chat_with_ai"
        android:src="@drawable/ic_gemini"
        app:backgroundTint="@color/white"
        app:elevation="@dimen/space_8"
        app:fabSize="normal"
        app:maxImageSize="30dp"
        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@null" />
</FrameLayout>
