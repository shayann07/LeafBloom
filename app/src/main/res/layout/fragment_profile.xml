<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fitsSystemWindows="false">

        <!-- Horizontal Guidelines -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="@dimen/safe_margin_v" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_end="@dimen/safe_margin_v" />

        <!-- Vertical Guidelines -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/safe_margin_h" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/safe_margin_h" />

        <!-- Header with background image -->
        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_header_height"
            android:clipChildren="true"
            android:clipToPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/auth_header_max_width">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHeader"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_gravity="top|center_horizontal"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.LeafBloom.AuthHeader"
                app:srcCompat="@drawable/profile_header" />

        </FrameLayout>

        <!-- Back Button (same as result screens) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/space_40"
            android:layout_height="@dimen/space_40"
            android:layout_marginTop="@dimen/space_24"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius_20"
            app:cardElevation="@dimen/space_0"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toTopOf="@id/guideline_top">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="@dimen/space_12"
                android:src="@drawable/back_icon"
                app:tint="@color/text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Header camera icon (bottom-right of header, above sheet) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnHeaderCamera"
            android:layout_width="@dimen/space_36"
            android:layout_height="@dimen/space_36"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_16"
            android:elevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius_20"
            app:cardElevation="@dimen/space_0"
            app:layout_constraintBottom_toBottomOf="@id/headerContainer"
            app:layout_constraintEnd_toEndOf="@id/guideline_end">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="@dimen/space_8"
                android:src="@drawable/change_profile_picture_icon"
                app:tint="@color/text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- White card sheet overlapping header bottom -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profileSheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:translationY="-80dp"
            app:cardBackgroundColor="?android:attr/colorBackground"
            app:cardCornerRadius="@dimen/radius_24"
            app:cardElevation="@dimen/space_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerContainer"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/safe_margin_h"
                android:paddingTop="@dimen/space_64"
                android:paddingBottom="40dp">

                <!-- User Name -->
                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/profile_placeholder_name"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface" />

                <!-- User Email -->
                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/profile_placeholder_email"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- =====================
                     Account Section
                     ===================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/account"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Edit Profile -->
                        <LinearLayout
                            android:id="@+id/rowEditProfile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/edit_profile_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/edit_profile"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/card_padding"
                            android:background="@color/divider" />

                        <!-- Change Password -->
                        <LinearLayout
                            android:id="@+id/rowChangePassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/password_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/change_password"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- =====================
                     Model Management Section
                     ===================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/model_management"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Storage Used -->
                        <LinearLayout
                            android:id="@+id/rowStorageUsed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/storage_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/storage_used"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/card_padding"
                            android:background="@color/divider" />

                        <!-- Check for Updates -->
                        <LinearLayout
                            android:id="@+id/rowCheckUpdates"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/server_cloud_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/check_for_updates"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/card_padding"
                            android:background="@color/divider" />

                        <!-- Clear Model Cache -->
                        <LinearLayout
                            android:id="@+id/rowClearCache"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/delete_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/clear_model_cache"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- =====================
                     App Settings Section
                     ===================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/app_settings"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Language -->
                        <LinearLayout
                            android:id="@+id/rowLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/language_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/change_language"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/card_padding"
                            android:background="@color/divider" />

                        <!-- Notifications -->
                        <LinearLayout
                            android:id="@+id/rowNotifications"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/notification_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/notifications"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/card_padding"
                            android:background="@color/divider" />

                        <!-- Dark Mode -->
                        <LinearLayout
                            android:id="@+id/rowDarkMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/dark_mode_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/dark_mode"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/card_padding"
                            android:background="@color/divider" />

                        <!-- Clear Scan History -->
                        <LinearLayout
                            android:id="@+id/rowClearHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/clear_history_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/clear_scan_history"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- =====================
                     Legal Section
                     ===================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/legal"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Terms & Conditions -->
                        <LinearLayout
                            android:id="@+id/rowTerms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/terms_condition_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:text="@string/terms_and_conditions"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/space_10"
                                android:layout_height="@dimen/space_10"
                                android:layout_gravity="top"
                                android:layout_marginStart="@dimen/space_6"
                                android:layout_marginTop="@dimen/space_2"
                                android:contentDescription="@null"
                                android:src="@drawable/link_open_icon"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/card_padding"
                            android:background="@color/divider" />

                        <!-- Privacy Policy -->
                        <LinearLayout
                            android:id="@+id/rowPrivacy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/privacy_policy_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:text="@string/privacy_policy"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/space_10"
                                android:layout_height="@dimen/space_10"
                                android:layout_gravity="top"
                                android:layout_marginStart="@dimen/space_6"
                                android:layout_marginTop="@dimen/space_2"
                                android:contentDescription="@null"
                                android:src="@drawable/link_open_icon"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/card_padding"
                            android:background="@color/divider" />

                        <!-- Help -->
                        <LinearLayout
                            android:id="@+id/rowHelp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/help_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:text="@string/help"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/space_10"
                                android:layout_height="@dimen/space_10"
                                android:layout_gravity="top"
                                android:layout_marginStart="@dimen/space_6"
                                android:layout_marginTop="@dimen/space_2"
                                android:contentDescription="@null"
                                android:src="@drawable/link_open_icon"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- =====================
                     Logout + Version
                     ===================== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/LeafLogoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_button"
                    android:layout_marginTop="@dimen/space_36"
                    android:text="@string/logout"
                    android:textColor="@color/status_error" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Version 1.0.0" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Profile Picture — overlaps sheet top edge -->
        <FrameLayout
            android:id="@+id/profilePictureContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="4dp"
            android:translationY="-130dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerContainer">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfilePicture"
                android:layout_width="@dimen/space_100"
                android:layout_height="@dimen/space_100"
                android:scaleType="centerCrop"
                android:src="@drawable/farmer_image"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

            <!-- Camera badge on profile picture -->
            <ImageView
                android:id="@+id/btnProfileCamera"
                android:layout_width="@dimen/space_28"
                android:layout_height="@dimen/space_28"
                android:layout_gravity="bottom|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/change_profile_picture_icon" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
