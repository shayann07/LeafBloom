<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/bottom_nav_height"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fitsSystemWindows="false">

        <!-- Horizontal Guidelines -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="@dimen/safe_margin_v" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_end="@dimen/safe_margin_v" />

        <!-- Vertical Guidelines -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/safe_margin_h" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/safe_margin_h" />

        <!-- Header with background image -->
        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_header_height"
            android:clipChildren="true"
            android:clipToPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/auth_header_max_width">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHeader"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_gravity="top|center_horizontal"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.LeafBloom.AuthHeader"
                app:srcCompat="@drawable/profile_header" />

        </FrameLayout>

        <!-- NEW: Top-right header camera (change header image) -->
        <ImageView
            android:id="@+id/btnHeaderEdit"
            android:layout_width="@dimen/space_28"
            android:layout_height="@dimen/space_28"
            android:layout_marginTop="@dimen/space_28"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/change_header_image"
            android:src="@drawable/change_profile_picture_icon"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintTop_toTopOf="@id/guideline_top" />

        <!-- Existing header camera (now changes avatar) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnHeaderCamera"
            android:layout_width="@dimen/space_36"
            android:layout_height="@dimen/space_36"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_16"
            android:elevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius_20"
            app:cardElevation="@dimen/space_0"
            app:layout_constraintBottom_toBottomOf="@id/headerContainer"
            app:layout_constraintEnd_toEndOf="@id/guideline_end">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/change_profile_picture"
                android:padding="@dimen/space_8"
                android:src="@drawable/change_profile_picture_icon"
                app:tint="@color/text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- White card sheet overlapping header bottom -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profileSheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:translationY="-80dp"
            app:cardBackgroundColor="?android:attr/colorBackground"
            app:cardCornerRadius="@dimen/radius_24"
            app:cardElevation="@dimen/space_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerContainer"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/safe_margin_h"
                android:paddingTop="@dimen/space_64"
                android:paddingBottom="40dp">

                <!-- Name (inline morph: TextView <-> plain EditText, same typography) -->
                <FrameLayout
                    android:id="@+id/nameContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/space_8"
                        android:paddingVertical="@dimen/space_2"
                        android:text="@string/profile_placeholder_name"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <EditText
                        android:id="@+id/etUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="center"
                        android:hint="@string/name_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/space_8"
                        android:paddingVertical="@dimen/space_2"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:visibility="invisible" />
                </FrameLayout>

                <!-- Email (inline morph: TextView <-> plain EditText, same typography) -->
                <FrameLayout
                    android:id="@+id/emailContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2">

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/space_8"
                        android:paddingVertical="@dimen/space_2"
                        android:text="@string/profile_placeholder_email"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <EditText
                        android:id="@+id/etUserEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="center"
                        android:hint="@string/email_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/space_8"
                        android:paddingVertical="@dimen/space_2"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:visibility="invisible" />
                </FrameLayout>

                <!-- =====================
                     Data Section
                     ===================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/data_section"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Clear Scan History -->
                        <LinearLayout
                            android:id="@+id/rowClearHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/clear_history_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:layout_weight="1"
                                android:text="@string/clear_scan_history"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/size_icon_18"
                                android:layout_height="@dimen/size_icon_18"
                                android:contentDescription="@null"
                                android:src="@drawable/chevron_right_icon"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- =====================
                     Legal Section
                     ===================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/legal"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Terms & Conditions -->
                        <LinearLayout
                            android:id="@+id/rowTerms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/terms_condition_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:text="@string/terms_and_conditions"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/space_10"
                                android:layout_height="@dimen/space_10"
                                android:layout_gravity="top"
                                android:layout_marginStart="@dimen/space_6"
                                android:layout_marginTop="@dimen/space_2"
                                android:contentDescription="@null"
                                android:src="@drawable/link_open_icon"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/card_padding"
                            android:background="@color/divider" />

                        <!-- Privacy Policy -->
                        <LinearLayout
                            android:id="@+id/rowPrivacy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/privacy_policy_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:text="@string/privacy_policy"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/space_10"
                                android:layout_height="@dimen/space_10"
                                android:layout_gravity="top"
                                android:layout_marginStart="@dimen/space_6"
                                android:layout_marginTop="@dimen/space_2"
                                android:contentDescription="@null"
                                android:src="@drawable/link_open_icon"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- =====================
                     Support Section
                     ===================== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/support"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/LeafBloomCard.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Help -->
                        <LinearLayout
                            android:id="@+id/rowHelp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:paddingVertical="@dimen/space_14">

                            <ImageView
                                android:layout_width="@dimen/size_icon_20"
                                android:layout_height="@dimen/size_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/help_icon"
                                app:tint="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_14"
                                android:text="@string/help"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="@dimen/space_10"
                                android:layout_height="@dimen/space_10"
                                android:layout_gravity="top"
                                android:layout_marginStart="@dimen/space_6"
                                android:layout_marginTop="@dimen/space_2"
                                android:contentDescription="@null"
                                android:src="@drawable/link_open_icon"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Version -->
                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_36"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Version 1.0.0" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Profile Picture — overlaps sheet top edge -->
        <FrameLayout
            android:id="@+id/profilePictureContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="4dp"
            android:translationY="-130dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerContainer">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfilePicture"
                android:layout_width="@dimen/space_100"
                android:layout_height="@dimen/space_100"
                android:scaleType="centerCrop"
                android:src="@drawable/farmer_image"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

            <!-- Camera badge on profile picture -->
            <ImageView
                android:id="@+id/btnProfileCamera"
                android:layout_width="@dimen/space_28"
                android:layout_height="@dimen/space_28"
                android:layout_gravity="bottom|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/change_profile_picture"
                android:src="@drawable/change_profile_picture_icon" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
